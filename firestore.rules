rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Dono é definido pelo campo owner_id no documento da unidade.
    // get() aqui só é usado em regras de operação pontual (escrita/leitura
    // direta), NUNCA em consultas de collection group.
    function isOwner(unitId) {
      return get(/databases/$(database)/documents/units/$(unitId)).data.owner_id == request.auth.uid;
    }

    // Membro = dono OU convidado com permissão ativa (doc de permissão = uid).
    function isMember(unitId) {
      return isOwner(unitId)
        || exists(/databases/$(database)/documents/units/$(unitId)/permissions/$(request.auth.uid));
    }

    // ----- profiles --------------------------------------------------------

    // Cada usuário só pode ler/escrever o próprio perfil (docId = uid).
    match /profiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ----- units -----------------------------------------------------------

    match /units/{unitId} {
      // Criar unidade: usuário autenticado vira dono (owner_id = próprio uid).
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      // Leitura para dono e convidados; alteração/exclusão somente do dono.
      // Usa resource (não get) p/ evitar recursão no próprio doc.
      allow read: if signedIn() &&
        (resource.data.owner_id == request.auth.uid ||
         exists(/databases/$(database)/documents/units/$(unitId)/permissions/$(request.auth.uid)));
      allow update, delete: if signedIn() && resource.data.owner_id == request.auth.uid;

      match /permissions/{permId} {
        // Escritas: somente o dono da unidade (get é permitido em operações pontuais).
        allow create, update: if signedIn() && isOwner(unitId);
        allow delete: if signedIn() && (isOwner(unitId) || request.auth.uid == resource.data.user_id);
      }

      match /registries/{regId} {
        // Registros (entrada/saída) somente para membros. Queries diretas
        // (subcoleção) permitem get()/exists().
        allow read, write: if signedIn() && isMember(unitId);
      }
    }

    // Collection group de permissions: leitura via wildcard recursivo e SEM
    // get()/exists() (obrigatório). Cobre getMyPermissions, getGuestPermissions,
    // getUnitGuests e os checks defensivos isGuest/isMember.
    match /{path=**}/permissions/{permId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.user_id ||
         resource.data.owner_id == request.auth.uid);
    }
  }
}
